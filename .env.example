# Application
PROJECT_NAME="ShopFlow"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="shopflow-super-secure-production-secret-key-change-in-prod"

# Database (PostgreSQL)
# Note: In Docker compose, host is 'postgres'. Locally, host is 'localhost'.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shopflow_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shopflow_db
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shopflow_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# RabbitMQ & Celery
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & JWT
JWT_SECRET=shopflow-jwt-super-secret-key-change-in-production-must-be-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_PER_MINUTE_USER=100
RATE_LIMIT_PER_MINUTE_IP=30

# Inventory Reservation
RESERVATION_EXPIRATION_MINUTES=10

# Simulated Payment
PAYMENT_SUCCESS_RATE=0.90
PAYMENT_TIMEOUT_RATE=0.05

# AWS Mock/Readiness
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
S3_BUCKET_NAME=shopflow-media-dev
